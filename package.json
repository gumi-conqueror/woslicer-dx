{
  "name": "woslicer-dx",
  "productName": "woslicer-dx",
  "version": "1.1.1",
  "description": "Offline BMS audio slicer with compatible .wos and original .bmh formats",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite --config vite.config.mts",
    "dev:desktop": "node scripts/tauri.mjs dev",
    "build": "node scripts/build-app-frontend.mjs web",
    "build:desktop": "node scripts/tauri.mjs build --no-bundle",
    "package:web": "node scripts/package-web.mjs --build",
    "package:desktop": "node scripts/tauri.mjs build",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:version",
    "check:version": "node scripts/check-version.js",
    "typecheck": "npm run generate:i18n && vue-tsc -p tsconfig.app.json --noEmit && tsc -p tests/tsconfig.tests.json --noEmit",
    "test": "npm run test:tooling && npm run test:components && npm run test:core",
    "test:tooling": "node --test scripts/*.test.mjs",
    "test:components": "vitest run --config tests/vitest.config.mts",
    "test:core": "node scripts/test-core.mjs",
    "test:ui": "node scripts/test-app-ui.mjs",
    "test:desktop": "node scripts/test-tauri-ui.mjs",
    "test:ipc": "node scripts/tauri-ipc-probe.mjs",
    "prelint": "npm run generate:i18n",
    "lint": "eslint . --max-warnings 0",
    "prelint:fix": "npm run generate:i18n",
    "lint:fix": "eslint . --fix",
    "prelint:staged": "npm run generate:i18n",
    "lint:staged": "lint-staged --concurrent false",
    "format": "oxfmt --write src tests scripts vite.config.mts playwright.app.config.mts eslint.config.mjs .oxfmtrc.json package.json tsconfig.json tsconfig.app.json tsconfig.lint.json .github/workflows .github/actions",
    "format:check": "oxfmt --check src tests scripts vite.config.mts playwright.app.config.mts eslint.config.mjs .oxfmtrc.json package.json tsconfig.json tsconfig.app.json tsconfig.lint.json .github/workflows .github/actions",
    "generate:i18n": "node scripts/gen-i18n.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-jp": "5.3.1",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@ibm/plex-sans-sc": "1.1.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "2.12",
    "@types/node": "^26.6.6",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "fontverter": "2.1.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "subset-font": "2.9.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@gumi-conqueror/audio-decode": "https://github.com/gumi-conqueror/audio-decode/releases/download/v0.1.0/gumi-conqueror-audio-decode-0.1.0.tgz",
    "@gumi-conqueror/bmh-file": "git+https://github.com/gumi-conqueror/bmh-file.git#22b1d1caf15524c33b489eb7d181bbc1d90bd892",
    "@gumi-conqueror/wos-file": "git+https://github.com/gumi-conqueror/wos-file.git#16d87d40d9cf099beef3a5783744f8d1cf9e292c",
    "@tauri-apps/api": "2.12",
    "@vueuse/core": "^15.0.0",
    "element-plus": "^2.14.8",
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumi-conqueror/woslicer-dx.git"
  }
}
