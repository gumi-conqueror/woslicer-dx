{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local editor can invoke offline operations and fixed About links.",
  "windows": ["main"],
  "permissions": [
    "allow-input-clock",
    "allow-yuancon-devices",
    "allow-yuancon-connect",
    "allow-yuancon-disconnect",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-about-link",
    "allow-app-data-folders",
    "allow-open-data-folder",
    "allow-open-file",
    "allow-open-files",
    "allow-reopen-file",
    "allow-open-project-media",
    "allow-begin-read",
    "allow-close-reader",
    "allow-read-file-chunk",
    "allow-prepare-save",
    "allow-begin-export",
    "allow-begin-export-file",
    "allow-write-chunk",
    "allow-finish-write",
    "allow-cancel-write",
    "allow-end-export",
    "allow-read-clipboard",
    "allow-write-clipboard",
    "allow-read-session",
    "allow-write-session",
    "allow-clear-session",
    "allow-set-theme",
    "allow-build-identity"
  ]
}
